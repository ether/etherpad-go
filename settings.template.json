{
  "title": "Etherpad",
  "showRecentPads": true,
  "favicon": null,
  "skinName": "colibris",
  "skinVariants": "super-light-toolbar super-light-editor light-background",
  /*
   * Look of the pad and timeslider pages on the colibris skin:
   * "etherpad-go" (default; grey, light and dark, like the admin UI) or
   * "colibris" (classic Etherpad, light green). accentColor replaces the
   * accent colour (#rgb or #rrggbb, colibris skin only), empty keeps the theme's own.
   */
  "padTheme": {
    "name": "etherpad-go",
    "accentColor": ""
  },
  "ip": "0.0.0.0",
  "port": "3000",
  "showSettingsInAdminPage": true,
  "enableMetrics": true,
  "cleanup": {
    "enabled": false,
    "keepRevisions": 5
  },
  "padRetention": {
    "enabled": false,
    "dryRun": true,
    "deleteAfterDays": 365,
    "warnBeforeDays": 7,
    "sweepIntervalHours": 1,
    "excludeGroupPads": true,
    "excludePattern": ""
  },
  "authenticationMethod": "sso",
  "enableDarkMode": true,
  "updateServer": "https://etherpad.org/ep_infos",
  "dbType": "memory",
  "dbSettings": {
    "host": null,
    "port": null,
    "database": null,
    "user": null,
    "password": null,
    "charset": null,
    "maxConnections": 25,
    "pgBouncer": false,
    "filename": "var/dirty.db",
    "collection": null,
    "url": null
  },
  "defaultPadText": "Welcome to Etherpad!\n\nThis pad text is synchronized as you type, so that everyone viewing this page sees the same text. This allows you to collaborate seamlessly on documents!\n\nGet involved with Etherpad at https://etherpad.org\n",
  "enablePadWideSettings": true,
  "allowPadDeletionByAllUsers": false,
  "suppressPadDeletionTokenModal": false,
  "padOptions": {
    "noColors": false,
    "showControls": true,
    "showChat": true,
    "showLineNumbers": true,
    "useMonospaceFont": false,
    "userName": null,
    "userColor": null,
    "rtl": false,
    "alwaysShowChat": false,
    "chatAndUsers": false,
    "lang": null,
    "fadeInactiveAuthorColors": true,
    "enforceReadableAuthorColors": true
  },
  "padShortcutEnabled": {
    "altF9": true,
    "altC": true,
    "cmdShift2": true,
    "delete": true,
    "return": true,
    "esc": true,
    "cmdS": true,
    "tab": true,
    "cmdZ": true,
    "cmdY": true,
    "cmdI": true,
    "cmdB": true,
    "cmdU": true,
    "cmd5": true,
    "cmdShiftL": true,
    "cmdShiftN": true,
    "cmdShift1": true,
    "cmdShiftC": true,
    "cmdH": true,
    "ctrlHome": true,
    "pageUp": true,
    "pageDown": true
  },
  "suppressErrorsInPadText": false,
  "requireSession": false,
  "editOnly": false,
  "minify": true,
  "maxAge": 21600,
  "abiword": null,
  "soffice": null,
  "allowUnknownFileEnds": true,
  /*
   * Fonts of the PDF export. Without this, a font family of the pad
   * (ep_font_family) is set in the embedded font of its kind: Liberation
   * Sans (Arial, Helvetica, ...), Liberation Serif (Times New Roman,
   * Garamond, ...) or Liberation Mono (Courier, ...). Give font files for a
   * family to use the real face; relative paths are relative to Etherpad's
   * root. A missing face uses the regular file; a file that cannot be read
   * falls back to "fallback" (sans-serif, serif or monospace).
   *
   * "exportPdfFonts": {
   *   "Garamond": "fonts/EBGaramond-Regular.ttf",
   *   "Arial": {"regular": "/usr/share/fonts/arial.ttf", "bold": "/usr/share/fonts/arialbd.ttf",
   *             "italic": "/usr/share/fonts/ariali.ttf", "boldItalic": "/usr/share/fonts/arialbi.ttf",
   *             "fallback": "sans-serif"}
   * },
   */
  "exportPdfFonts": {},
  /*
   * Who may do what is set in the admin UI (accounts and roles). On the first
   * start with account management, requireAuthentication decides what visitors
   * who are not logged in may do: false lets them edit and create pads, true
   * lets only logged-in people in. Later changes here have no effect.
   */
  "requireAuthentication": false,
  "requireAuthorization": false,
  "trustProxy": false,
  "cookie": {
    "keyRotationInterval": 86400000,
    "prefix": "",
    "sameSite": "Lax",
    "sessionLifetime": 864000000,
    "sessionRefreshInterval": 86400000,
    "sessionCleanup": true
  },
  "cluster": {
    "mode": "auto",
    "bindAddr": "",
    "bindPort": 7946,
    "advertiseAddr": "",
    "advertisePort": 0,
    "shutdownDelaySeconds": 5
  },
  "updates": {
    "tier": "notify",
    "githubRepo": "ether/etherpad-go",
    "checkIntervalHours": 6,
    "installMethod": "auto",
    "preApplyGraceMinutes": 0,
    "drainSeconds": 60,
    "rollbackHealthCheckSeconds": 60,
    "requireSignature": false,
    "trustedPublicKey": "",
    "stateFile": "var/update-state.json",
    "maintenanceWindow": {
      "start": "",
      "end": "",
      "tz": "local"
    }
  },
  "gdprAuthorErasure": {
    "enabled": false
  },
  "adminEmail": "",
  "mail": {
    "host": "",
    "port": 587,
    "secure": false,
    "from": "",
    "auth": null
  },
  "disableIPlogging": false,
  "automaticReconnectionTimeout": 0,
  "scrollWhenFocusLineIsOutOfViewport": {
    "percentage": {
      "editionAboveViewport": 0,
      "editionBelowViewport": 0
    },
    "duration": 0,
    "scrollWhenCaretIsInTheLastLineOfViewport": false,
    "percentageToScrollWhenUserPressesArrowUp": 0
  },
  /*
   * The first admin, created while there is no admin who can log in. The
   * password must be changed at the first login. EP_BOOTSTRAP_ADMIN_USER and
   * EP_BOOTSTRAP_ADMIN_PASSWORD take precedence. Without them, create admins
   * with "etherpad-go admin create <username>", which prints a one-time
   * password; "etherpad-go admin reset-password <username>" gets you back in.
   */
  "bootstrapAdmin": {
    "username": null,
    "password": null
  },
  /*
   * etherpad-lite's users. They are taken over into the account management once
   * (passwords hashed, is_admin → admin, readOnly → viewer) and not read
   * afterwards; manage accounts in the admin UI.
   */
  "users": {
    "admin": {
      "password": null,
      "is_admin": true
    },
    "user": {
      "password": null,
      "is_admin": false
    }
  },
  "socketTransportProtocols": ["websocket", "polling"],
  "socketIo": {
    "maxHttpBufferSize": 1048576
  },
  "loadTest": false,
  "dumpOnUncleanExit": false,
  "importExportRateLimiting": {
    "windowMs": 90000,
    "max": 10
  },
  "importMaxFileSize": 52428800,
  "commitRateLimiting": {
    "duration": 1,
    "points": 10
  },
  "exposeVersion": false,
  "loglevel": "INFO",
  "customLocaleStrings": {},
  "enableAdminUITests": false,
  "lowerCasePadIds": false,
  /*
   * Tokens (API keys) of accounts: whether they must expire and how long
   * they may live at most (days, 0: no maximum), for the personal tokens of
   * people and for those of service accounts. Existing tokens keep their
   * expiry; the rules apply when a token is issued, rotated or changed.
   */
  "tokens": {
    "personal": { "requireExpiry": false, "maxLifetimeDays": 0 },
    "service": { "requireExpiry": false, "maxLifetimeDays": 0 }
  },

  /*
   * The MCP server at /mcp lets AI clients (Claude, ...) read and edit pads
   * with a token. With "oauth" on, clients such as claude.ai connectors
   * register themselves and connect after the person logs in and agrees
   * (scopes and pads they allow, never more than their own rights); the
   * issuer of "sso" must then be the address people reach Etherpad at.
   */
  "mcp": {
    "oauth": true
  },

  /*
   * The built-in OpenID Connect provider. The client of type "admin" is the
   * admin UI; the client of type "user" lets people log in on the pads
   * ("Log in" in the toolbar, and pads visitors may not open lead to the
   * login). Its callback, <issuer origin>/auth/callback, is allowed without
   * listing it; the issuer must be the address people open the pads at.
   * Without a "user" client, nobody logs in on the pads.
   */
  "sso": {
    "issuer": "http://localhost:9001",
    "clients": [
      {
        "type": "admin",
        "client_id": "admin_client",
        "client_secret": "admin",
        "grant_types": ["authorization_code"],
        "response_types": ["code"],
        "redirect_uris": ["http://localhost:9001/admin/"]
      },
      {
        "type": "user",
        "client_id": "user_client",
        "client_secret": "user",
        "grant_types": ["authorization_code"],
        "response_types": ["code"],
        "redirect_uris": ["http://localhost:9001/"]
      }
    ]
  },
  "plugins": {
    "ep_align": {
      "enabled": false
    },
    "ep_author_hover": {
      "enabled": false
    },
    "ep_chat_log_join_leave": {
      "enabled": false
    },
    "ep_clear_formatting": {
      "enabled": false
    },
    "ep_cursortrace": {
      "enabled": false
    },
    "ep_font_color": {
      "enabled": false
    },
    "ep_font_family": {
      "enabled": false
    },
    "ep_font_size": {
      "enabled": false
    },
    "ep_markdown": {
      "enabled": false
    },
    "ep_print": {
      "enabled": false
    },
    "ep_spellcheck": {
      "enabled": false
    },
    "ep_table_of_contents": {
      "enabled": false
    }
  }
}
