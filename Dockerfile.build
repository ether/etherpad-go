FROM debian:bookworm-slim AS cache

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*


FROM golang:alpine AS backend
WORKDIR /app

RUN go install github.com/a-h/templ/cmd/templ@latest
COPY ./go.mod ./go.sum ./
RUN go mod download

COPY . .

ARG TARGETOS
ARG TARGETARCH

RUN templ generate
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -ldflags="-s -w" -o app .


FROM alpine:3.24 AS busybox
RUN apk add --no-cache busybox-static \
    && mkdir -p /rootfs/bin \
    && cp /bin/busybox.static /rootfs/bin/busybox \
    && ln -s /bin/busybox /rootfs/bin/sh

FROM scratch AS runtime
EXPOSE 3000

ENV NODE_ENV=production
ENV ETHERPAD_SETTINGS_PATH=/
COPY --from=backend /app/app /app
COPY --from=busybox /rootfs /


COPY --from=cache /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
ENV PATH="/:/bin"
ENTRYPOINT ["/app"]
