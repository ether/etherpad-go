{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Plugins import core modules as ep_etherpad-lite/static/js/...; build.js
       maps that to src/js/ when bundling, tsc needs the same mapping. */
    "paths": {
      "ep_etherpad-lite/static/js/*": ["./src/js/*"]
    }
  },
  "include": ["src"]
}
